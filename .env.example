# Project Configuration
PROJECT_NAME=NexPyRS
STACK_NAME=nexpyrs
DOMAIN=localhost

# Database Connections (URLs)
POSTGRES_URL=postgresql://postgres:password@db:5432/nexpyrs_dev
MONGO_URL=mongodb://mongodb:27017/nexpyrs_dev

# Message Brokers & Cache
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
KAFKA_BROKER_URL=kafka:9092
REDIS_URL=redis://redis:6379/0

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@nexpyrs.dev
PGADMIN_DEFAULT_PASSWORD=admin

# Traefik Configuration
TRAEFIK_PORT=80
TRAEFIK_SECURE_PORT=443
TRAEFIK_DASHBOARD_PORT=8090
